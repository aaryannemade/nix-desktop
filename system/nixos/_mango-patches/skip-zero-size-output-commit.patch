+/*
+ * Whether committing @state would give @output a non-zero resolution.
+ * wlroots asserts width > 0 && height > 0 when it (re)creates the primary
+ * swapchain, so a zero-sized output must never reach build_state.
+ */
+static bool output_state_has_size(struct wlr_output *output,
+								  const struct wlr_output_state *state) {
+	int32_t width = output->width;
+	int32_t height = output->height;
+
+	/* Disabling an output does not allocate a swapchain. */
+	if (state->committed & WLR_OUTPUT_STATE_ENABLED) {
+		if (!state->enabled)
+			return true;
+	} else if (!output->enabled) {
+		return true;
+	}
+
+	if (state->committed & WLR_OUTPUT_STATE_MODE) {
+		if (state->mode_type == WLR_OUTPUT_STATE_MODE_FIXED) {
+			width = state->mode ? state->mode->width : 0;
+			height = state->mode ? state->mode->height : 0;
+		} else {
+			width = state->custom_mode.width;
+			height = state->custom_mode.height;
+		}
+	}
+
+	return width > 0 && height > 0;
+}
+
 bool mango_scene_output_commit(struct wlr_scene_output *scene_output,
