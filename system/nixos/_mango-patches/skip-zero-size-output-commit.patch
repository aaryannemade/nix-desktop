+	/*
+	 * After resume from suspend a DRM connector (seen with NVIDIA USB-C
+	 * outputs) can briefly report a 0x0 mode while the link retrains.
+	 * Committing then aborts inside wlr_swapchain_create. Skip this commit,
+	 * keep the pending state, and retry shortly instead of crashing.
+	 */
+	if (!output_state_has_size(wlr_output, state)) {
+		mango_error(true, WLR_INFO,
+					"Output %s has no valid size yet, deferring commit",
+					wlr_output->name);
+		if (m && m->skip_frame_timeout)
+			wl_event_source_timer_update(m->skip_frame_timeout, 250);
+		return false;
+	}
